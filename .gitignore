# Environment variables (contains sensitive API keys)
.env

# Node modules
node_modules/

# Build output
*.min.css
*.min.js

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Netlify
.netlify/

# Local GTM container snapshots (audit scratch). The real rollback anchor is GTM's own
# Versions UI, which retains every published version — see GTM-CHANGES.md.
.gtm-snapshots/

# NOTE: netlify.toml sets publish = ".", so ANY file committed here is served at its own
# public URL. Keep source material (raw photos, client paperwork, contact lists) outside
# this directory entirely — .gitignore does not protect you, because `netlify deploy`
# uploads the publish dir from local disk regardless of git.

# Internal strategy docs — netlify.toml has publish = ".", so anything committed
# here is publicly fetchable (see the earlier "stop serving internal documentation
# from the publish root" fix). Keep these out of the repo entirely.
SEO-OFFSITE-PLAYBOOK.pdf

# Debris from `netlify dev` / edge-function local runs
deno.lock
